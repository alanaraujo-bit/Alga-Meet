# Build context filter for infra/web/Dockerfile (BuildKit reads <Dockerfile>.dockerignore next to the Dockerfile).
# Allowlist: everything is excluded, then only what the Dockerfile copies is let back in.
*
!package.json
!package-lock.json
!tsconfig.base.json
!packages/shared/package.json
!packages/shared/src/**
!apps/server/package.json
!apps/desktop/package.json
!apps/desktop/livekit-red.ts
!apps/desktop/vite.web.config.ts
!apps/desktop/tsconfig.json
!apps/desktop/tsconfig.web.json
!apps/desktop/src/**
!infra/web/Caddyfile
# Never, even inside allowed folders.
**/.env
**/.env.*
**/node_modules
