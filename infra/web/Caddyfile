# Alga Meet PWA (infra/web/Dockerfile). Railway terminates HTTPS and sends plain HTTP to $PORT.
{
	admin off
	auto_https off
}

:{$PORT:8080} {
	encode zstd gzip

	# The API and the gateway WebSocket, on this same origin. Host must be the upstream's for Railway's router.
	@api path /api/* /gateway /gateway/*
	handle @api {
		reverse_proxy {$ALGA_API_UPSTREAM} {
			header_up Host {upstream_hostport}
		}
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), fullscreen=(self), autoplay=(self \"https://www.youtube.com\" \"https://www.youtube-nocookie.com\")"
	}

	# Hashed build files: forever when they exist, a plain 404 when they do not (a tab from before a deploy asking for
	# a chunk that is gone must fail, never get index.html back under an "immutable" header).
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		# Everything else, the page above all, is checked again on every load so a deploy shows up at once.
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
