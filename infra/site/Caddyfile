# Alga Meet site (infra/site/Dockerfile). Railway terminates HTTPS and sends plain HTTP to $PORT.
{
	admin off
	auto_https off
}

:{$PORT:8080} {
	encode zstd gzip

	# www → the bare domain, one address for everyone.
	@www header_regexp Host ^www\.(.+)$
	redir @www https://{re.1}{uri} permanent

	# The invite page's preview (GET /api/v1/invites/:code), on this same origin. Host must be the upstream's.
	handle /api/* {
		reverse_proxy {$ALGA_API_UPSTREAM} {
			header_up Host {upstream_hostport}
		}
	}

	handle {
		root * /srv
		header /_astro/* Cache-Control "public, max-age=31536000, immutable"
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
		}
		# Every invite link (/i/<code>) is the same static page; it reads the code from the path.
		@invite path_regexp ^/i/[0-9A-Za-z]{1,32}/?$
		rewrite @invite /i/index.html
		file_server
	}
}
