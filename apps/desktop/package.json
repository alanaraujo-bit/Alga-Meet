{
  "name": "@alga/desktop",
  "productName": "Alga Meet",
  "version": "0.1.2",
  "private": true,
  "description": "Alga Meet — voz, transmissão de tela e comunidades.",
  "author": "Alga",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/build-activity.mjs && electron-vite dev",
    "build": "node scripts/build-activity.mjs && electron-vite build",
    "build:activity": "node scripts/build-activity.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "node scripts/build-activity.mjs && electron-vite build && electron-builder --win --publish never",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@alga/shared": "*",
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "livekit-client": "^2.23.0",
    "motion": "^14.9.0",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  }
}
