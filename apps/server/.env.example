# Copie para .env (não versionado) e ajuste. Todos os valores abaixo são os padrões de desenvolvimento.
# Sem NODE_ENV o servidor assume production (falha fechada): exige DATABASE_URL, CORS_ORIGINS e chave/segredo
# LiveKit reais. `npm run dev` passa --dev, que define NODE_ENV=development.
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
LOG_LEVEL=info
# Atrás de proxy reverso (Railway etc.): IPs/CIDRs do proxy (ex. 10.0.0.0/8,100.64.0.0/10) ou o número de saltos
# (ex. 1; só é seguro se a API não for alcançável sem passar pelo proxy). "true" é recusado: confiaria em qualquer
# X-Forwarded-For enviado pelo cliente e anularia o rate limit.
TRUST_PROXY=false

# Postgres 16+. Sem DATABASE_URL o servidor usa PGlite (Postgres WASM) em PGLITE_DIR.
# DATABASE_URL=postgres://alga:alga@127.0.0.1:5432/alga
# PGLITE_DIR=./data/pglite   (memory:// para banco efêmero)

# LiveKit: LIVEKIT_URL é usado servidor->SFU (API/twirp); LIVEKIT_PUBLIC_URL vai para o cliente.
LIVEKIT_URL=http://127.0.0.1:7880
LIVEKIT_PUBLIC_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
# Valores de desenvolvimento (infra/livekit/livekit.dev.yaml, públicos). Só são aceitos com NODE_ENV=development/test
# e HOST loopback, ou com ALGA_ALLOW_DEV_SECRETS=1 (ex. teste em LAN com HOST=0.0.0.0).
LIVEKIT_API_SECRET=alga-dev-secret-change-me-0123456789abcdef
# ALGA_ALLOW_DEV_SECRETS=0

# Origens permitidas (CSV). "null" e "file://" cobrem o renderer empacotado do Electron. Obrigatório em produção.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,null,file://

# URL pública da API como os clientes a veem (URLs de arquivo e avatar são absolutas). Produção: obrigatória, https.
# Sem ela, em dev, vale http://HOST:PORT.
# PUBLIC_URL=https://api.algameet.com.br
# Chave HMAC das URLs assinadas de download (/api/v1/files/:id?uid=&exp=&sig=). Produção: obrigatória, >= 32
# caracteres aleatórios (ex.: `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`).
# Em dev/test, sem valor, é aleatória a cada processo (links antigos deixam de valer ao reiniciar).
# FILES_SECRET=
# Validade das URLs de download em segundos (padrão 3600, arredondada para cima em 5 min).
# FILE_URL_TTL_SECONDS=3600
# Teto por arquivo anexado em bytes (padrão 25 MiB; até 10 arquivos por mensagem). Avatares/ícones: 8 MiB fixos.
# MAX_ATTACHMENT_BYTES=26214400

# Armazenamento dos uploads. Produção: obrigatório escolher. "local" = disco (dev, ou volume persistente montado em
# UPLOADS_DIR); "s3" = qualquer bucket compatível (Railway Buckets, Cloudflare R2, AWS S3, MinIO).
STORAGE_DRIVER=local
# UPLOADS_DIR=./data/uploads
# S3_ENDPOINT=https://t3.storageapi.dev
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# virtual (padrão: Railway, R2, AWS) ou path (MinIO e buckets antigos do Railway; a aba Credentials diz qual).
# S3_URL_STYLE=virtual

# E-mail transacional (verificação de e-mail, redefinição de senha). Produção: obrigatório escolher.
# console = cada e-mail vira um .eml em EMAIL_OUTBOX_DIR e uma linha de log (o corpo, com o link/token, só fora de
#           produção). Em produção só com ALGA_ALLOW_CONSOLE_EMAIL=1 (ex.: staging sem provedor).
# resend  = API REST da Resend (POST https://api.resend.com/emails); exige RESEND_API_KEY e EMAIL_FROM com domínio
#           verificado na Resend (SPF/DKIM: docs/infra/deploy.md §1). Outro provedor: ver apps/server/README.md.
EMAIL_DRIVER=console
# ALGA_ALLOW_CONSOLE_EMAIL=0
# EMAIL_OUTBOX_DIR=./data/outbox
# EMAIL_FROM=Alga Meet <nao-responda@algameet.com.br>
# RESEND_API_KEY=
# Base dos links nos e-mails: <base>/verify-email?token=… e <base>/reset-password?token=… (deep link do app ou uma
# página https que envia o token para a API). O e-mail também traz o código para colar no app.
# EMAIL_LINK_URL=algameet://auth

# Pagamentos (apps/server/README.md "Pagamentos e direitos"; estratégia em docs/business/monetization.md).
# none = desligado (checkout responde 503); sandbox = provedor de teste, nada é cobrado (padrão em development/test,
# RECUSADO em produção, sem exceção); mercadopago = Checkout Pro + assinaturas (preapproval). Produção: padrão none.
# BILLING_PROVIDER=sandbox
# Mercado Pago (Suas integrações > Credenciais / Webhooks). Webhook no painel: <PUBLIC_URL>/api/v1/billing/webhooks/mercadopago
# com os tópicos payment, subscription_preapproval e subscription_authorized_payment.
# MP_ACCESS_TOKEN=
# "Assinatura secreta" do webhook (valida o header x-signature).
# MP_WEBHOOK_SECRET=
# MP_API_URL=https://api.mercadopago.com
# Página https para onde o comprador volta depois de pagar (ex.: página do site que abre algameet://). Obrigatória
# com mercadopago.
# BILLING_RETURN_URL=https://algameet.com.br/billing/return

# Trust & Safety e privacidade (docs/trust-safety/README.md).
# Cadastro: em produção birthDate (AAAA-MM-DD) e termsVersion (GET /api/v1/legal) são sempre obrigatórios. Fora de
# produção são opcionais (só geram um aviso no log) até o desktop mandar os campos; REQUIRE_BIRTHDATE=1 os exige.
# REQUIRE_BIRTHDATE=0
# Onde os Termos, a Política e as Diretrizes publicados ficam (links de GET /legal: <base>/termos-de-uso etc.).
# LEGAL_URL=https://algameet.com.br/legal
# Papel de equipe (moderator/admin): só pelo script, nunca pela API. Com PGlite, pare o servidor antes:
#   npx tsx scripts/grant-staff.ts <username> <admin|moderator|none>
