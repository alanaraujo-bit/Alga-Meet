---
// A marca do site mora só aqui: Encosto v2 final, copiado de apps/desktop/build/brand/web/ (lockup 735 × 160).
import lockup from '../assets/brand/lockup.svg?url';
interface Props { height?: number; class?: string }
const { height = 26, class: cls } = Astro.props;
const width = Math.round(height * (735 / 160));
---
<img class:list={['logo', cls]} src={lockup} width={width} height={height} style={`width:${width}px;height:${height}px`} alt="Alga Meet" decoding="async" />

<style>
  .logo { display: block; flex: none; max-width: none; }
</style>
