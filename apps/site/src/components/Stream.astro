---
// "Sua tela, nítida": a lente. Nível A desenha o jogo ao vivo (src/scripts/lens/game.ts);
// B e C usam duas fotos do MESMO quadro do jogo (1080p e 720p) e a lente em CSS.
import { Picture } from 'astro:assets';
import { facts } from '../data/facts';
import hi from '../assets/game/frame-1080.png';
import lo from '../assets/game/frame-720.png';
---
<section class="stream" id="tela" aria-labelledby="tela-t">
  <div class="wrap head">
    <p class="eyebrow" data-reveal>Transmissão de tela</p>
    <h2 id="tela-t" data-reveal>Sua tela, <em>nítida.</em></h2>
    <p class="lede" data-reveal>Passe a lente pela transmissão. Fora dela, <strong>720p</strong>: o grátis de lá. Dentro, <strong>1080p</strong>: o grátis daqui. A placa de vídeo codifica, então o jogo nem sente a live.</p>
  </div>

  <figure class="screen wrap" data-reveal>
    <div class="frame" data-lens-host style="--lx:30%;--ly:22%;--lr:140px">
      <div class="still lo" aria-hidden="true">
        <Picture src={lo} formats={['avif', 'webp']} widths={[1280]} sizes="(min-width: 1260px) 1200px, 100vw" alt="" loading="lazy" />
      </div>
      <div class="still hi">
        <Picture src={hi} formats={['avif', 'webp']} widths={[1280, 1920]} sizes="(min-width: 1260px) 1200px, 100vw" alt="Quadro de um jogo de corrida de planadores num canal entre prédios, na hora azul, com placar, minimapa e o chat do grupo. Dentro da lente, a imagem em 1080p; fora, em 720p." loading="lazy" />
      </div>
      <div class="game" data-game aria-hidden="true"></div>
      <span class="live" aria-hidden="true"><i>AO VIVO</i> Alan Araújo</span>
      <span class="out" aria-hidden="true"><b>{facts.discordFreeStream}</b> fora da lente · Discord grátis</span>
      <span class="lens-tag" data-lens-tag aria-hidden="true"><b>1080p30</b> Alga Meet grátis</span>
    </div>
    <figcaption>Simulação de resolução: o mesmo quadro, com 2/3 da resolução fora da lente (720 de 1080 linhas). O jogo é gerado aqui, ao vivo, no seu navegador; não mostra a diferença de quadros por segundo.</figcaption>
  </figure>

  <div class="wrap">
    <div class="tiers">
      <div class="tier" data-reveal>
        <p class="who">Grátis</p>
        <ul>{facts.freeStream.map((q) => <li class="chip">{q}</li>)}</ul>
        <p class="note">Quem assiste nunca paga nada.</p>
      </div>
      <div class="tier plus" data-reveal style="--d:80ms">
        <p class="who">Alga Plus</p>
        <ul>{facts.plusStream.map((q) => <li class="chip">{q}</li>)}</ul>
        <p class="note">Para a noite de cinema e para quem mostra o jogo.</p>
      </div>
      <div class="tier cpu" data-reveal style="--d:160ms">
        <p class="num tnum"><span data-count="3.4" data-dec="1">{facts.streamCpuPct}</span><small>% de CPU</small></p>
        <p class="note">Transmitindo 1080p60 com encode por hardware (NVENC) num i5-13600KF. Placas AMD e Intel ainda em teste.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .stream { position: relative; padding-block: clamp(96px, 16vh, 180px); }
  .head { display: grid; gap: 16px; max-width: 820px; }
  h2 em { font-style: normal; color: #a9acff; }

  .screen { margin-top: clamp(40px, 7vh, 72px); max-width: calc(1200px + 2 * var(--gutter)); }
  .frame {
    position: relative; aspect-ratio: 16 / 9; border-radius: 16px; overflow: hidden; background: #070812; cursor: none; touch-action: pan-y;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.1), 0 40px 120px rgba(0, 0, 0, 0.6), 0 0 160px rgba(97, 99, 208, 0.25);
  }
  .still, .still :global(picture), .still :global(img), .game, .game :global(canvas) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .still :global(img) { object-fit: cover; }
  /* a foto de 1080p só aparece dentro da lente */
  .hi { clip-path: circle(var(--lr) at var(--lx) var(--ly)); }
  .hi::after { content: ''; position: absolute; inset: 0; pointer-events: none; }
  .frame::after {
    content: ''; position: absolute; left: var(--lx); top: var(--ly); width: calc(var(--lr) * 2); height: calc(var(--lr) * 2); margin: calc(var(--lr) * -1) 0 0 calc(var(--lr) * -1);
    border-radius: 50%; pointer-events: none; box-shadow: inset 0 0 0 1.5px rgba(220, 222, 255, 0.85), 0 0 0 999px rgba(0, 0, 0, 0.12), 0 12px 40px rgba(0, 0, 0, 0.45);
  }
  .frame:global(.gl)::after, .frame:global(.gl) .still { display: none; }
  .game { display: none; }
  .frame:global(.gl) .game { display: block; }
  .live, .out, .lens-tag {
    position: absolute; z-index: 2; display: inline-flex; align-items: center; gap: 8px; height: 28px; padding: 0 10px; border-radius: 8px;
    font-size: 12px; font-weight: 560; color: var(--text-2); background: rgba(8, 9, 18, 0.78); box-shadow: inset 0 0 0 1px var(--line-2); pointer-events: none; white-space: nowrap;
  }
  .live { left: 14px; bottom: 14px; color: var(--text-1); }
  .live i { font-style: normal; font-size: 11px; font-weight: 650; padding: 2px 6px; border-radius: 5px; background: var(--live-fill); color: #fff; }
  .out { right: 14px; bottom: 14px; }
  .out b, .lens-tag b { color: var(--text-1); font-weight: 650; }
  .lens-tag { left: 0; top: 0; color: var(--text-1); background: rgba(70, 72, 170, 0.85); box-shadow: inset 0 0 0 1px rgba(200, 204, 255, 0.4); transform: translate(var(--lx), var(--ly)); }
  .lens-tag b { color: #fff; }
  figcaption { margin: 12px 0 0; font-size: 13px; line-height: 1.5; color: var(--text-3); max-width: 70em; }

  .tiers { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; max-width: 1200px; margin: 28px auto 0; }
  .tier { padding: 22px; border-radius: 16px; background: linear-gradient(180deg, rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0.015)); box-shadow: inset 0 0 0 1px var(--line-1), var(--top-light); }
  .who { font-size: 13px; font-weight: 590; color: var(--text-3); }
  .plus .who { color: var(--accent); }
  .tier ul { list-style: none; margin: 14px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .chip { height: 30px; display: inline-flex; align-items: center; padding: 0 10px; border-radius: 8px; font-size: 14px; font-weight: 590; color: var(--text-1); background: rgba(255, 255, 255, 0.06); box-shadow: inset 0 0 0 1px var(--line-2); font-variant-numeric: tabular-nums; }
  .plus .chip { background: var(--accent-tint); box-shadow: inset 0 0 0 1px rgba(139, 142, 247, 0.28); }
  .note { margin-top: 12px; font-size: 14px; line-height: 1.5; color: var(--text-3); }
  .num { font-size: clamp(40px, 4.6vw, 56px); line-height: 1; letter-spacing: -0.04em; font-weight: 600; color: var(--text-1); font-variation-settings: 'opsz' 32; }
  .num small { font-size: 0.36em; letter-spacing: -0.01em; color: var(--text-3); font-weight: 510; margin-left: 4px; }

  @media (max-width: 860px) { .tiers { grid-template-columns: 1fr 1fr; } .cpu { grid-column: span 2; } }
  @media (max-width: 560px) {
    .tiers { grid-template-columns: 1fr; } .cpu { grid-column: auto; }
    .screen { padding-inline: 0; }
    .frame { border-radius: 0; }
    .out { display: none; }
    .live, .lens-tag { font-size: 11px; height: 24px; }
  }
</style>
