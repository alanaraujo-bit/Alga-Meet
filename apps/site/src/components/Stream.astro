---
import { Picture } from 'astro:assets';
import { facts } from '../data/facts';
import r1080 from '../assets/shots/res-1080.png';
import r720 from '../assets/shots/res-720.png';
---
<section class="stream" id="tela" aria-labelledby="tela-t">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow" data-reveal>Transmissão de tela</p>
      <h2 id="tela-t" data-reveal>Transmita como se estivesse do lado.</h2>
      <p class="lede" data-reveal>1080p de graça, para quem transmite e para quem assiste. A placa de vídeo codifica em HEVC, então o jogo nem sente a live.</p>
    </div>

    <figure class="cmp-fig" data-reveal>
    <div class="compare" data-compare style="--pos:50%">
      <div class="layer hi">
        <Picture src={r1080} formats={['avif', 'webp']} widths={[960]} sizes="960px" alt="Recorte da conversa do app em 1080p: texto nítido." loading="lazy" />
      </div>
      <div class="layer lo" aria-hidden="true">
        <Picture src={r720} formats={['avif', 'webp']} widths={[640]} sizes="960px" alt="" loading="lazy" class="up" />
      </div>
      <div class="divider" aria-hidden="true"><span class="handle"><svg width="18" height="18" viewBox="0 0 18 18"><path d="M6 4 2 9l4 5M12 4l4 5-4 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span></div>
      <span class="tag left"><b>{facts.discordFreeStream}</b> Discord grátis</span>
      <span class="tag right"><b>1080p30</b> Alga Meet grátis</span>
      <label class="sr-only" for="cmp-range">Comparar 720p e 1080p</label>
      <input id="cmp-range" type="range" min="0" max="100" value="50" />
    </div>
      <figcaption>Mesmo recorte de tela, reduzido à resolução de cada plano grátis. Arraste para comparar. Simulação de resolução: não mostra a diferença de quadros por segundo.</figcaption>
    </figure>

    <div class="tiers">
      <div class="tier" data-reveal>
        <p class="who">Grátis</p>
        <ul>{facts.freeStream.map((q) => <li class="chip">{q}</li>)}</ul>
        <p class="note">Quem assiste nunca paga nada.</p>
      </div>
      <div class="tier plus" data-reveal style="--d:80ms">
        <p class="who">Alga Plus</p>
        <ul>{facts.plusStream.map((q) => <li class="chip">{q}</li>)}</ul>
        <p class="note">Para a noite de cinema e para quem mostra o jogo.</p>
      </div>
      <div class="tier cpu" data-reveal style="--d:160ms">
        <p class="num tnum"><span data-count="3.4" data-dec="1">{facts.streamCpuPct}</span><small>% de CPU</small></p>
        <p class="note">Transmitindo 1080p60 com encode por hardware (NVENC) num i5-13600KF. Placas AMD e Intel ainda em teste.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .stream { position: relative; padding-block: clamp(80px, 14vh, 160px); }
  .stream::before {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: radial-gradient(55% 45% at 85% 40%, rgba(97, 99, 208, 0.13), transparent 70%);
  }
  .head { display: grid; gap: 16px; max-width: 760px; }

  .cmp-fig { margin: clamp(40px, 7vh, 72px) auto 0; max-width: 960px; }
  .compare {
    position: relative;
    border-radius: 14px; overflow: hidden; aspect-ratio: 16 / 9;
    background: var(--bg-1);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.09), 0 30px 80px rgba(0, 0, 0, 0.5);
  }
  .layer, .layer :global(picture), .layer :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .layer :global(img) { object-fit: cover; }
  .lo { clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  .divider { position: absolute; top: 0; bottom: 0; left: var(--pos); width: 2px; margin-left: -1px; background: rgba(255, 255, 255, 0.85); box-shadow: 0 0 20px rgba(139, 142, 247, 0.6); pointer-events: none; }
  .handle {
    position: absolute; top: 50%; left: 50%; width: 40px; height: 40px; margin: -20px 0 0 -20px; border-radius: 50%;
    display: grid; place-items: center; color: var(--text-1);
    background: rgba(24, 24, 28, 0.92); box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.18), 0 6px 20px rgba(0, 0, 0, 0.5);
  }
  .tag {
    position: absolute; top: 14px; display: inline-flex; gap: 6px; align-items: center; height: 28px; padding: 0 10px; border-radius: 8px;
    font-size: 12px; color: var(--text-2); background: rgba(10, 10, 12, 0.82); box-shadow: inset 0 0 0 1px var(--line-2);
    pointer-events: none;
  }
  .tag b { color: var(--text-1); font-weight: 590; }
  .tag.left { left: 14px; }
  .tag.right { right: 14px; }
  .tag.right b { color: var(--accent); }
  .compare input[type='range'] {
    position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; touch-action: pan-y;
  }
  .compare:has(input:focus-visible) .handle { outline: 2px solid var(--accent); outline-offset: 3px; }
  figcaption { margin: 12px 0 0; font-size: 13px; line-height: 1.5; color: var(--text-3); }
  .tiers { margin-top: 28px; }

  .tiers { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; max-width: 960px; margin-inline: auto; margin-top: 28px; }
  .tier { padding: 22px; border-radius: 16px; background: linear-gradient(180deg, rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0.015)); box-shadow: inset 0 0 0 1px var(--line-1), var(--top-light); }
  .who { font-size: 13px; font-weight: 590; color: var(--text-3); }
  .plus .who { color: var(--accent); }
  .tier ul { list-style: none; margin: 14px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .chip { height: 30px; display: inline-flex; align-items: center; padding: 0 10px; border-radius: 8px; font-size: 14px; font-weight: 590; color: var(--text-1); background: rgba(255, 255, 255, 0.06); box-shadow: inset 0 0 0 1px var(--line-2); font-variant-numeric: tabular-nums; }
  .plus .chip { background: var(--accent-tint); box-shadow: inset 0 0 0 1px rgba(139, 142, 247, 0.28); }
  .note { margin-top: 12px; font-size: 14px; line-height: 1.5; color: var(--text-3); }
  .num { font-size: clamp(40px, 4.6vw, 56px); line-height: 1; letter-spacing: -0.04em; font-weight: 600; color: var(--text-1); font-variation-settings: 'opsz' 32; }
  .num small { font-size: 0.36em; letter-spacing: -0.01em; color: var(--text-3); font-weight: 510; margin-left: 4px; }

  @media (max-width: 860px) { .tiers { grid-template-columns: 1fr 1fr; } .cpu { grid-column: span 2; } }
  @media (max-width: 560px) { .tiers { grid-template-columns: 1fr; } .cpu { grid-column: auto; } .tag { font-size: 11px; height: 24px; top: 10px; } .tag.left { left: 10px; } .tag.right { right: 10px; } }
</style>
