---
// Botão de download: link direto para o instalador da release mais recente (src/data/links.ts).
// Se um dia o link ficar vazio, o botão volta a abrir o aviso honesto de beta fechado.
interface Props { size?: 'md' | 'lg'; label?: string; class?: string }
const { size = 'lg', label = 'Baixar para Windows', class: cls } = Astro.props;
import { downloadUrl as url } from '../data/links';
const classes = ['btn', 'btn-primary', size === 'lg' && 'btn-lg', cls];
---
{url ? (
  <a class:list={classes} href={url} data-download>
    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M3 5.5 10 4.5v7H3zM11 4.4 21 3v8.5H11zM3 12.5h7v7l-7-1zM11 12.5h10V21l-10-1.4z"/></svg>
    {label}
  </a>
) : (
  <button type="button" class:list={classes} data-invite-open aria-haspopup="dialog">
    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M3 5.5 10 4.5v7H3zM11 4.4 21 3v8.5H11zM3 12.5h7v7l-7-1zM11 12.5h10V21l-10-1.4z"/></svg>
    {label}
  </button>
)}
