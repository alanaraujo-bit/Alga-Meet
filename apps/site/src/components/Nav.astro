---
import Logo from './Logo.astro';
import Download from './Download.astro';
const links = [
  ['#voz', 'Voz'],
  ['#tela', 'Tela'],
  ['#leve', 'Leveza'],
  ['#grupo', 'Grupo'],
  ['#privacidade', 'Privacidade'],
  ['#plus', 'Plus'],
];
---
<header class="nav" data-nav>
  <div class="bar">
    <a href="#topo" class="home" aria-label="Alga Meet, voltar ao topo"><Logo /></a>
    <nav aria-label="Seções">
      <ul>{links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
    </nav>
    <Download size="md" label="Baixar" class="nav-cta" />
  </div>
</header>

<style>
  .nav { position: fixed; inset: 12px 0 auto; z-index: 100; display: flex; justify-content: center; padding-inline: 12px; pointer-events: none; }
  .bar {
    pointer-events: auto;
    display: flex; align-items: center; gap: 8px;
    width: min(100%, 980px); height: 56px; padding: 0 8px 0 18px; border-radius: 16px;
    background: transparent; box-shadow: none;
    transition: background-color 300ms var(--ease-out), box-shadow 300ms var(--ease-out), backdrop-filter 300ms var(--ease-out);
  }
  .nav:global(.scrolled) .bar {
    background: rgba(18, 18, 21, 0.72);
    -webkit-backdrop-filter: blur(20px) saturate(1.6);
    backdrop-filter: blur(20px) saturate(1.6);
    box-shadow: inset 0 0 0 1px var(--line-2), inset 0 1px 0 rgba(255, 255, 255, 0.06), 0 12px 40px rgba(0, 0, 0, 0.4);
  }
  /* Celular fraco: vidro custa GPU; fundo sólido no lugar. */
  :global(html.tier-c) .nav:global(.scrolled) .bar, :global(html.tier-b) .nav:global(.scrolled) .bar { -webkit-backdrop-filter: none; backdrop-filter: none; background: rgba(16, 16, 18, 0.96); }
  .home { text-decoration: none; display: inline-flex; align-items: center; height: 40px; border-radius: 8px; }
  nav { flex: 1; display: flex; justify-content: center; }
  ul { display: flex; gap: 2px; list-style: none; margin: 0; padding: 0; }
  ul a {
    display: inline-flex; align-items: center; height: 34px; padding: 0 12px; border-radius: 8px;
    font-size: 14px; font-weight: 510; color: var(--text-3); text-decoration: none;
    transition: color 120ms var(--ease-out), background-color 120ms var(--ease-out);
  }
  ul a:hover { color: var(--text-1); background: rgba(255, 255, 255, 0.05); transition-duration: 0ms; }
  ul a[aria-current] { color: var(--text-1); background: rgba(255, 255, 255, 0.06); }
  .bar :global(.nav-cta) { --h: 40px; padding: 0 16px; font-size: 14px; }
  @media (max-width: 860px) {
    nav { visibility: hidden; }
    .bar { padding-left: 14px; }
  }
</style>
