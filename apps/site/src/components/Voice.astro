---
import { facts } from '../data/facts';
import { people, lines } from '../data/conversation';
import { Picture } from 'astro:assets';
import roomStill from '../assets/media/room.png';
const dots = (w: number) => `background:linear-gradient(135deg,${people[w].grad[0]},${people[w].grad[1]})`;
const lost = facts.packetsSent.toLocaleString('pt-BR');

// Onda desenhada no build: fala em rajadas (sílabas) e, na versão com ruído, chiado por baixo de tudo.
let seed = 7;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const env = (x: number) => {
  const bursts = [[60, 150], [175, 260], [300, 330], [360, 470], [500, 545]];
  let a = 0;
  for (const [s, e] of bursts) if (x > s && x < e) a = Math.max(a, Math.sin(((x - s) / (e - s)) * Math.PI));
  return a;
};
const noise = Array.from({ length: 301 }, () => rnd() * 2 - 1);
const line = (withNoise: boolean) => {
  let d = '';
  for (let i = 0; i <= 300; i++) {
    const x = i * 2;
    const y = 80 - env(x) * 58 * Math.sin(x * 0.42) * (0.7 + 0.3 * Math.sin(x * 0.07)) - (withNoise ? noise[i] * 14 : 0);
    d += (i ? 'L' : 'M') + x + ' ' + y.toFixed(1);
  }
  return d;
};
const hiss = () => line(true);
const speech = () => line(false);
---
<section class="voice" id="voz" aria-labelledby="voz-t">
  <!-- A sala: capítulo preso no nível A (WebGL); B/C mostram a mesma conversa parada. -->
  <div class="room-ch" data-room-ch>
    <span class="anchor" id="sala" aria-hidden="true"></span>
    <div class="room-stage" data-room-stage>
      <div class="room-gl" data-room-gl aria-hidden="true"></div>
      <div class="room-head wrap">
        <p class="eyebrow">A sala</p>
        <h2 id="voz-t" class="chapter-t">Fala que a gente <em>vê.</em></h2>
        <p class="room-lede">Cada voz vira luz no chão. Role, e a conversa anda.</p>
      </div>
      <div class="names" aria-hidden="true">{people.map((p, i) => <span class="name" data-name={i}>{p.name}</span>)}</div>
      <p class="caption" data-caption aria-hidden="true"><b data-cap-who></b><span data-cap-text></span></p>
      <button type="button" class="listen" data-listen aria-pressed="false">
        <span class="eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <span class="l-off">Ouvir a sala</span><span class="l-on">Silenciar</span>
      </button>
      <p class="latency" data-latency><span class="tnum">{facts.voiceLatencyMs} ms</span> da boca de um ao ouvido do outro.</p>
      <div class="media room-media wrap" data-video="/media/room.mp4" aria-hidden="true">
        <Picture src={roomStill} formats={['avif', 'webp']} widths={[960, 1280]} sizes="(min-width: 1240px) 1160px, 100vw" alt="" loading="lazy" />
      </div>
      <ol class="transcript" aria-label="A conversa da sala">
        {lines.map((l) => (
          <li class:list={[l.laugh && 'laugh']}>
            <span class="dots" aria-hidden="true">{l.who.map((w) => <i style={dots(w)}></i>)}</span>
            <b>{l.laugh ? 'Todo mundo' : people[l.who[0]].name}</b> <span>{l.text}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>

  <div class="wrap">
    <p class="lit" data-reveal>Quando alguém ri, você ouve a risada. <span>Não um eco. Não um robô. Não meio segundo depois.</span></p>
    <div class="grid">
      <article class="stat big" data-reveal>
        <p class="num tnum"><span data-count={facts.voiceLatencyMs}>{facts.voiceLatencyMs}</span><small> ms</small></p>
        <h3>da boca de um ao ouvido do outro</h3>
        <p class="note">Passando pelo servidor de voz. Mediana em 10 minutos de chamada na rede local.</p>
      </article>
      <article class="stat" data-reveal style="--d:80ms">
        <p class="num tnum"><span data-count={facts.packetsLost}>{facts.packetsLost}</span><small> de {lost}</small></p>
        <h3>pacotes de voz perdidos</h3>
        <p class="note">No mesmo teste. Em rede ruim, a correção de perda (RED + FEC) segura a fala.</p>
      </article>
      <article class="stat" data-reveal style="--d:160ms">
        <p class="num tnum"><span data-count={facts.joinMs}>{facts.joinMs}</span><small> ms</small></p>
        <h3>do clique até estar na sala</h3>
        <p class="note">Entrar num canal de voz é instantâneo de verdade.</p>
      </article>

      <article class="noise" data-noise data-reveal style="--d:80ms">
        <div class="noise-copy">
          <h3>O teclado fica do seu lado da tela.</h3>
          <p>Supressão de ruído no próprio PC tira ventilador, teclado e o cachorro do vizinho antes de a sua voz sair. Custa {facts.noiseSuppressionCostMs} ms.</p>
          <button type="button" class="toggle" aria-pressed="false" data-noise-toggle>
            <span class="knob" aria-hidden="true"></span>
            <span class="t-off">Supressão de ruído desligada</span><span class="t-on">Supressão de ruído ligada</span>
          </button>
        </div>
        <svg class="wave" viewBox="0 0 600 160" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <linearGradient id="wg" x1="0" x2="1"><stop offset="0" stop-color="#8b8ef7" stop-opacity="0"/><stop offset=".15" stop-color="#8b8ef7"/><stop offset=".85" stop-color="#8b8ef7"/><stop offset="1" stop-color="#8b8ef7" stop-opacity="0"/></linearGradient>
          </defs>
          <path class="hiss" d={hiss()} />
          <path class="speech" d={speech()} />
        </svg>
      </article>

      <article class="stat equal" data-reveal style="--d:160ms">
        <p class="num"><small>Voz</small> igual</p>
        <h3>para todo mundo</h3>
        <p class="note">{facts.voiceKbps} kbps em Opus com correção de perda, no grátis e no pago. Ninguém paga para ser ouvido melhor.</p>
      </article>
    </div>

    <p class="source" data-reveal>Medido em 01/11/2026 em rede local, com duas instâncias do app e o nosso servidor de voz. Pela internet, some o caminho até o servidor (em São Paulo, no lançamento).</p>
  </div>
</section>

<style>
  .voice { position: relative; padding-bottom: clamp(64px, 10vh, 120px); }

  /* ---- A sala ---- B/C (e sem JS): cabeçalho + a conversa como transcrição ---- */
  .room-ch { position: relative; }
  .anchor { position: absolute; left: 0; top: 0; }
  .room-stage { position: relative; padding-block: clamp(96px, 14vh, 160px) 24px; }
  .room-gl, .names, .caption, .latency, .listen { display: none; }
  .room-head { position: relative; z-index: 2; }
  .room-media { margin-top: clamp(28px, 4vh, 48px); }
  .room-media :global(img), .room-media :global(video) { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 16px; background: #010102; }
  .room-media :global(video) { position: absolute; inset: 0; }
  .room-media { position: relative; }
  .room-media :global(video) { left: var(--gutter); right: var(--gutter); width: calc(100% - 2 * var(--gutter)); }
  :global(html.tier-a) .room-media { display: none; }
  .chapter-t em { font-style: normal; color: #a9acff; }
  .room-lede { margin-top: 12px; color: var(--text-3); font-size: clamp(16px, 1.4vw, 19px); }
  .transcript { list-style: none; margin: clamp(32px, 5vh, 56px) auto 0; padding: 0 var(--gutter); max-width: var(--maxw); display: grid; gap: 10px; }
  .transcript li { display: flex; align-items: baseline; gap: 10px; font-size: clamp(18px, 2.2vw, 28px); line-height: 1.3; letter-spacing: -0.02em; color: var(--text-2); }
  .transcript b { color: var(--text-1); font-weight: 600; flex: none; }
  .transcript .dots { display: inline-flex; flex: none; transform: translateY(2px); }
  .transcript .dots i { width: 18px; height: 18px; border-radius: 50%; margin-right: -5px; box-shadow: 0 0 0 2px var(--bg-1); }
  .transcript .laugh span { color: #a9acff; }

  /* ---- Nível A: palco preso de tela cheia com o WebGL ---- */
  :global(html.tier-a) .room-ch { height: 460vh; }
  /* a água escurece até o preto da sala: sem borda seca entre os capítulos */
  :global(html.tier-a) .room-ch::before { content: ''; position: absolute; left: 0; right: 0; top: -50vh; height: 50vh; pointer-events: none; background: linear-gradient(rgba(1, 1, 2, 0), #010102); }
  :global(html.tier-a) .room-ch::after { content: ''; position: absolute; left: 0; right: 0; bottom: -40vh; height: 40vh; pointer-events: none; background: linear-gradient(#010102, rgba(1, 1, 2, 0)); }
  :global(html.tier-a) .anchor { top: calc(0.16 * 360vh); }
  :global(html.tier-a) .room-stage { position: sticky; top: 0; height: 100vh; height: 100lvh; overflow: hidden; padding: 0; background: #010102; }
  :global(html.tier-a) .room-gl { display: block; position: absolute; inset: 0; }
  :global(html.tier-a) .room-gl :global(canvas) { display: block; width: 100%; height: 100%; }
  :global(html.tier-a) .room-head { position: absolute; left: 0; right: 0; top: clamp(88px, 13vh, 132px); pointer-events: none; }
  :global(html.tier-a) .transcript { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); margin: 0; padding: 0; }
  :global(html.tier-a) .names { display: block; position: absolute; inset: 0; pointer-events: none; }
  .name {
    position: absolute; left: 0; top: 0; padding: 3px 9px; border-radius: 999px; font-size: 13px; font-weight: 560; color: var(--text-3);
    background: rgba(10, 10, 16, 0.6); white-space: nowrap; opacity: 0; transition: color 160ms var(--ease-out), box-shadow 160ms var(--ease-out);
  }
  .name:global(.on) { color: var(--text-1); box-shadow: inset 0 0 0 1px rgba(160, 165, 255, 0.5); }
  :global(html.tier-a) .caption {
    display: block; position: absolute; left: 50%; bottom: clamp(76px, 9vh, 104px); transform: translateX(-50%); width: min(92vw, 860px); text-align: center;
    font-size: clamp(22px, 2.8vw, 38px); line-height: 1.2; letter-spacing: -0.025em; font-weight: 580; color: var(--text-1); text-wrap: balance;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.8); min-height: 2.4em;
  }
  .caption b { display: block; margin-bottom: 6px; font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase; color: #a9acff; font-weight: 600; }
  :global(html.tier-a) .listen {
    display: inline-flex; align-items: center; gap: 10px; position: absolute; right: max(var(--gutter), calc(50vw - 600px)); bottom: clamp(24px, 4vh, 40px); z-index: 3;
    height: 44px; padding: 0 18px 0 14px; border: 0; border-radius: 999px; cursor: pointer; font-size: 14px; font-weight: 560; color: var(--text-1);
    background: rgba(255, 255, 255, 0.06); box-shadow: inset 0 0 0 1px rgba(160, 165, 255, 0.35); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
  }
  .listen:hover { background: rgba(139, 142, 247, 0.16); }
  .eq { display: inline-flex; align-items: center; gap: 2px; height: 16px; }
  .eq i { width: 2px; height: 100%; border-radius: 1px; background: #a9acff; transform: scaleY(0.3); }
  .listen[aria-pressed='true'] .eq i { animation: eq 700ms ease-in-out infinite alternate; }
  .eq i:nth-child(2) { animation-delay: -200ms; } .eq i:nth-child(3) { animation-delay: -450ms; } .eq i:nth-child(4) { animation-delay: -100ms; }
  @keyframes eq { from { transform: scaleY(0.25); } to { transform: scaleY(1); } }
  .l-on, .listen[aria-pressed='true'] .l-off { display: none; }
  .listen[aria-pressed='true'] .l-on { display: inline; }
  :global(html.tier-a) .latency {
    display: block; position: absolute; left: 0; right: 0; top: 50%; transform: translateY(-50%); text-align: center; opacity: 0; pointer-events: none;
    font-size: clamp(18px, 2vw, 26px); color: var(--text-2); font-weight: 520; letter-spacing: -0.01em;
  }
  :global(html.tier-a) .latency::before { content: ''; position: absolute; inset: -30vh -10vw; z-index: -1; background: radial-gradient(closest-side, rgba(1, 1, 2, 0.85), rgba(1, 1, 2, 0)); }
  .latency span { display: block; font-size: clamp(96px, 17vw, 240px); line-height: 0.9; letter-spacing: -0.06em; font-weight: 640; color: var(--text-1); font-variation-settings: 'opsz' 32; text-shadow: 0 0 60px rgba(139, 142, 247, 0.5); }
  .voice::before {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: radial-gradient(50% 40% at 15% 30%, rgba(97, 99, 208, 0.12), transparent 70%);
  }
  h2 { margin-top: 14px; }
  .lit {
    margin-top: clamp(64px, 10vh, 120px); max-width: 22em;
    font-size: clamp(26px, 3.6vw, 46px); line-height: 1.18; letter-spacing: -0.025em; font-weight: 560;
    font-variation-settings: 'opsz' 32; color: var(--text-1);
  }
  .lit span { color: var(--text-3); }

  .grid { margin-top: clamp(48px, 8vh, 88px); display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .stat, .noise {
    position: relative; padding: 24px; border-radius: 16px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0.015));
    box-shadow: inset 0 0 0 1px var(--line-1), var(--top-light);
  }
  .num { font-size: clamp(44px, 5.4vw, 68px); line-height: 1; letter-spacing: -0.04em; font-weight: 600; color: var(--text-1); font-variation-settings: 'opsz' 32; }
  .num small { font-size: 0.4em; letter-spacing: -0.01em; color: var(--text-3); font-weight: 510; }
  .big .num { color: var(--accent); }
  .stat h3 { margin-top: 14px; font-size: 16px; }
  .note { margin-top: 8px; font-size: 14px; line-height: 1.5; color: var(--text-3); }

  .noise { grid-column: span 2; display: grid; grid-template-columns: 1fr 1.2fr; gap: 24px; align-items: center; overflow: hidden; }
  .noise h3 { font-size: clamp(20px, 2vw, 24px); }
  .noise p { margin-top: 10px; font-size: 15px; color: var(--text-3); }
  .toggle {
    margin-top: 20px; display: inline-flex; align-items: center; gap: 12px; height: 40px; padding: 0 14px 0 6px; border: 0; border-radius: 999px; cursor: pointer;
    background: rgba(255, 255, 255, 0.05); box-shadow: inset 0 0 0 1px var(--line-2); font-size: 14px; font-weight: 510; color: var(--text-2);
  }
  .knob { position: relative; width: 44px; height: 26px; border-radius: 999px; background: rgba(255, 255, 255, 0.12); transition: background-color 160ms var(--ease-out); }
  .knob::after { content: ''; position: absolute; left: 3px; top: 3px; width: 20px; height: 20px; border-radius: 50%; background: #fff; box-shadow: 0 1px 2px rgba(0, 0, 0, 0.3); transition: transform 220ms var(--ease-out); }
  .toggle[aria-pressed='true'] .knob { background: var(--sheen), var(--accent-fill); }
  .toggle[aria-pressed='true'] .knob::after { transform: translateX(18px); }
  .t-on, .toggle[aria-pressed='true'] .t-off { display: none; }
  .toggle[aria-pressed='true'] .t-on { display: inline; }
  .wave { width: 100%; height: 160px; }
  .wave path { fill: none; stroke: url(#wg); stroke-width: 2; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .hiss { opacity: 0.55; transition: opacity 400ms var(--ease-out); }
  .speech { opacity: 0.35; transition: opacity 400ms var(--ease-out); }
  .noise:global(.clean) .hiss { opacity: 0; }
  .noise:global(.clean) .speech { opacity: 1; }
  :global(html.tier-a) .hiss { animation: jitter 180ms steps(3) infinite; }
  @keyframes jitter { 50% { transform: translateY(1.5px); } }

  .equal .num { font-size: clamp(40px, 4.6vw, 56px); }
  .source { margin-top: 20px; font-size: 13px; color: var(--text-3); max-width: 60em; }

  @media (max-width: 960px) {
    .grid { grid-template-columns: 1fr 1fr; }
    .big { grid-column: span 2; }
    .noise { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .grid { grid-template-columns: 1fr; }
    .big, .noise { grid-column: auto; }
    .stat, .noise { padding: 20px; }
  }
</style>
