---
import Download from './Download.astro';
import Logo from './Logo.astro';
import mark from '../assets/brand/mark.svg?url';
import { facts } from '../data/facts';
import { downloadNote, releasesUrl } from '../data/links';
import { Picture } from 'astro:assets';
import finalStill from '../assets/media/final.png';
const year = new Date().getFullYear();
---
<section class="final" aria-labelledby="final-t" data-final>
  <div class="final-stage" data-final-stage>
    <div class="horizon" data-horizon aria-hidden="true"></div>
    <div class="media final-media" data-video="/media/final.mp4" data-once aria-hidden="true">
      <Picture src={finalStill} formats={['avif', 'webp']} widths={[960, 1440]} sizes="100vw" alt="" loading="lazy" />
    </div>
    <div class="wrap inner">
      <img class="mark" src={mark} width="72" height="72" alt="" data-reveal />
      <span class="mark-space" aria-hidden="true"></span>
      <h2 id="final-t" data-final-t>Chama o <em>pessoal.</em></h2>
      <p class="lede" data-final-in>Baixe, crie um espaço e mande o convite. Em dois minutos vocês estão conversando.</p>
      <div class="cta" data-final-in><Download /></div>
      <p class="specs" data-final-in>{downloadNote} · instalador de {facts.installerMb} MB · <a href={releasesUrl} rel="noopener">ver novidades</a></p>
    </div>
  </div>
</section>

<footer class="foot">
  <div class="wrap row">
    <Logo height={22} />
    <p>Feito no Brasil, para conversar de perto. © {year} Alga Meet.</p>
  </div>
</footer>

<style>
  .final { position: relative; overflow: clip; text-align: center; isolation: isolate; }
  .final-stage { position: relative; padding-block: clamp(120px, 20vh, 220px) clamp(120px, 18vh, 200px); }
  h2 em { font-style: normal; color: #a9acff; }
  .mark-space { display: none; }
  .final-media { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .final-media :global(picture), .final-media :global(img), .final-media :global(video) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }
  .final-media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(11, 11, 12, 0.2), rgba(11, 11, 12, 0.1) 40%, rgba(11, 11, 12, 0.75) 75%, var(--bg-1)); }
  :global(html:not(.tier-a)) .final .horizon, :global(html:not(.tier-a)) .final::before { display: none; }
  :global(html.tier-a) .final-media { display: none; }
  /* B/C: as frondes do vídeo/foto fazem o papel da marca; o texto desce até a água */
  :global(html:not(.tier-a)) .final .mark { display: none; }
  :global(html:not(.tier-a)) .final-stage { padding-top: clamp(280px, 46vh, 460px); }
  /* Nível A: a superfície. A água sobe, o horizonte da hora azul nasce (WebGL) e as frondes se encontram. */
  :global(html.gl-on) .final { height: 260vh; overflow: visible; }
  :global(html.gl-on) .final-stage { position: sticky; top: 0; height: 100vh; height: 100lvh; padding: 0; display: grid; place-items: center; }
  :global(html.gl-on) .final .horizon, :global(html.gl-on) .final::before, :global(html.gl-on) .mark { display: none; }
  :global(html.gl-on) .mark-space { display: block; height: clamp(150px, 24vh, 240px); }
  :global(html.gl-on) .final h2 { text-shadow: 0 4px 40px rgba(6, 8, 30, 0.6); }
  :global(html.gl-on) .final .lede { color: var(--text-2); text-shadow: 0 2px 20px rgba(6, 8, 30, 0.8); }
  :global(html.gl-on) .final .specs { color: #b8bcd6; }

  /* Horizonte da hora azul: a borda de um planeta escuro com a luz índigo nascendo atrás. */
  .horizon {
    position: absolute; left: 50%; top: 74%; width: max(1400px, 170vw); aspect-ratio: 1; margin-left: calc(max(1400px, 170vw) / -2); z-index: -1; border-radius: 50%;
    background: radial-gradient(closest-side, #09090b 98.6%, rgba(9, 9, 11, 0) 100%);
    box-shadow: 0 -1px 0 rgba(214, 218, 255, 0.55), 0 -24px 80px rgba(139, 142, 247, 0.38), 0 -80px 220px rgba(97, 99, 208, 0.42);
  }
  .final::before { content: ''; position: absolute; inset: 0; z-index: -2; background: radial-gradient(60% 50% at 50% 92%, rgba(97, 99, 208, 0.28), transparent 70%); }
  .inner { display: grid; justify-items: center; gap: 22px; }
  .mark { width: 72px; height: 72px; filter: drop-shadow(0 8px 30px rgba(139, 142, 247, 0.45)); }
  h2 { font-size: clamp(44px, 8vw, 104px); letter-spacing: -0.04em; }
  .lede { text-align: center; }
  .specs { font-size: 13px; color: var(--text-3); }
  .foot { border-top: 1px solid var(--line-1); padding-block: 28px calc(28px + env(safe-area-inset-bottom)); }
  .row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 24px; }
  .row p { font-size: 13px; color: var(--text-3); }
</style>
